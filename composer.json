{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "hackathon-fiap-soat/fiapx-video-processor",
    "type": "project",
    "description": "FIAP X: worker que extrai 1 frame por segundo com ffmpeg, gera o zip no S3 e responde à SAGA (Laravel 13, DDD + Clean Architecture)",
    "keywords": [
        "fiapx",
        "laravel",
        "ffmpeg",
        "sqs",
        "keda"
    ],
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "ext-pcntl": "*",
        "ext-zip": "*",
        "aws/aws-sdk-php": "^3.403",
        "laravel/framework": "^13.17",
        "ramsey/uuid": "^4.10"
    },
    "require-dev": {
        "larastan/larastan": "^3.15",
        "laravel/pint": "^1.27",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.6",
        "opis/json-schema": "^2.6",
        "phpunit/phpunit": "^12.5.12"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": [
            "@php artisan config:clear --ansi",
            "phpunit --no-coverage"
        ],
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "pre-package-uninstall": [
            "Illuminate\\Foundation\\ComposerScripts::prePackageUninstall"
        ],
        "lint": [
            "pint --test",
            "phpstan analyse --memory-limit=1G --no-progress"
        ],
        "test:coverage": [
            "@php -d pcov.enabled=1 vendor/bin/phpunit",
            "@php scripts/coverage-check.php coverage/clover.xml 80"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
