# Ambiente local (docker compose deste repositório, na rede do fiapx-infra/local).
# Valores fictícios de uso local. Na AWS, as variáveis vêm do ConfigMap do Kubernetes.
# O worker não tem banco: DB_CONNECTION não é usado.

APP_NAME=fiapx-video-processor
APP_ENV=local
APP_DEBUG=false
LOG_CHANNEL=json
LOG_LEVEL=info
CACHE_STORE=array

# AWS: LocalStack. O bucket e as filas vêm do SSM /fiapx/local/...
FIAPX_ENV=local
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_ENDPOINT_URL=http://localstack:4566

# Opcionais (sem elas, valem o SSM e os padrões da documentação)
# SQS_PROCESSING_COMMANDS_URL=
# SQS_SAGA_REPLIES_URL=
# FIAPX_WORK_DIR=/work
# FIAPX_WORKER_ID=            # padrão: hostname (nome do pod)
# FIAPX_CONSUMER_WAIT_SECONDS=20
# FIAPX_MAX_ATTEMPTS=3
# FIAPX_FFMPEG_TIMEOUT_SECONDS=1500
# FIAPX_HEARTBEAT_INTERVAL_SECONDS=60
# FIAPX_HEARTBEAT_EXTENSION_SECONDS=300
